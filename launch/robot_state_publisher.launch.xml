<launch version="0.1.1">
  
  <!-- Process the URDF file -->
  <arg
    name="model"
    default="$(find-pkg-share my_first_bot)/description/robot.urdf.xacro"
    description="Absolute path to robot urdf.xacro file" />

  <!-- Publish the joint states of the robot to determine the current position of robot's moving joints -->
  <node pkg="joint_state_publisher" exec="joint_state_publisher" name="joint_state_publisher" />
  
  <!-- Publish the robot's state to the rest of the ROS system, including the transforms between the robot's links -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var model)')" />
  </node>

  <!-- Spawn Entity in Gazebo -->
  <node pkg="ros_gz_sim" exec="create" args="-topic robot_description -name my_first_bot -z 0.1" output="screen"/>
    
</launch>